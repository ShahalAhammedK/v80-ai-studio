# OpenAI API key. Keep this server-side only — never expose it to the browser.
OPENAI_API_KEY=your_api_key_here

# Configurable image editing model. Check https://platform.openai.com/docs/guides/image-generation
# for the current model list before changing this.
IMAGE_MODEL=gpt-image-2.5-sunburst

# Optional alternate image-editing provider. Gemini has no mask parameter —
# fidelity outside the person relies entirely on the server-side pixel
# composite in backend/image_utils.py.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# "openai" or "gemini". Leave blank to auto-pick: gemini if GEMINI_API_KEY is
# set, otherwise openai.
IMAGE_PROVIDER=

# Chat/vision model used only for the optional gender-suggestion feature.
CHAT_MODEL=gpt-5.6-luna

# Optional: route CHAT_MODEL calls through an OpenAI-Chat-Completions-compatible
# gateway instead of calling OpenAI directly. Leave both blank to call OpenAI directly.
EXPLABS_API_KEY=
EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1

# Max upload size per image, in megabytes.
MAX_UPLOAD_MB=12

# Simple in-memory rate limit for the AI edit endpoint (requests per minute per IP).
RATE_LIMIT_PER_MINUTE=10
